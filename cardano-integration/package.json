{
    "name": "@pharma-verify/cardano-integration",
    "version": "2.0.0",
    "description": "Cardano blockchain integration with Aiken validators",
    "main": "dist/index.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
        "build": "tsc",
        "build:aiken": "cd aiken && aiken build",
        "test:aiken": "cd aiken && aiken check",
        "start": "node dist/index.js"
    },
    "dependencies": {
        "@blockfrost/blockfrost-js": "^5.4.0",
        "@emurgo/cardano-serialization-lib-nodejs": "^12.0.0",
        "@meshsdk/core": "^1.5.0",
        "ioredis": "^5.3.2",
        "dotenv": "^16.3.1",
        "axios": "^1.6.2"
    },
    "devDependencies": {
        "@types/node": "^20.10.5",
        "typescript": "^5.3.3",
        "ts-node-dev": "^2.0.0"
    }
}